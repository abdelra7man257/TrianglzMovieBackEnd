# Copy to .env and fill in. .env is git-ignored.
TMDB_API_KEY=
TMDB_SYNC_PAGES=10
DB_USERNAME=movies
DB_PASSWORD=movies
# Host port for Postgres (change if 5432 is already in use)
DB_PORT=5432
# Host port for the API (the Android emulator reaches it at http://10.0.2.2:<port>)
API_PORT=8080
# Path inside the container, e.g. /secrets/firebase-service-account.json (empty = log-only FCM)
FIREBASE_CREDENTIALS_PATH=
FCM_TOPIC=movie-updates
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
