# Copy to .env and fill in. .env is git-ignored.
TMDB_API_KEY=
TMDB_SYNC_PAGES=10
DB_USERNAME=movies
DB_PASSWORD=movies
# Path inside the container, e.g. /secrets/firebase-service-account.json (empty = log-only FCM)
FIREBASE_CREDENTIALS_PATH=
FCM_TOPIC=movie-updates
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
